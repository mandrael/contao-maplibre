<?php if ($this->mapHasMarkers): ?>

<div class="ce_maplibre_map block<?= $this->class ?>"<?= $this->cssID ?>>

  <?php if ($this->headline): ?>
    <<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
  <?php endif; ?>

  <div class="maplibre-map" id="<?= $this->mapId ?>" data-height="<?= (int) $this->mapHeight ?>" data-maplibre="<?= \Contao\StringUtil::specialchars($this->mapConfig) ?>"></div>

</div>

<?php endif; ?>
